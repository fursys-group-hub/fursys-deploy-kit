var MAX_FILE_SIZE = 1048576;
function walkDir(dir, rootDir) {
  const results = [];
  let entries;
  try {
    entries = fs.readdirSync(dir, { withFileTypes: true });
  } catch {
    return results;
  }
  for (const entry of entries) {
    const fullPath = path.join(dir, entry.name);
    if (entry.isDirectory()) {
      if (SKIP_DIRS.has(entry.name)) continue;
      results.push(...walkDir(fullPath, rootDir));
    } else if (entry.isFile()) {
      if (SKIP_FILES.has(entry.name)) continue;
      if (BINARY_EXTENSIONS.has(path.extname(entry.name).toLowerCase())) continue;
      results.push(fullPath);
    }
  }
  return results;
}
function gitDeployableSet(rootDir) {
  if (!fs.existsSync(path.join(rootDir, ".git"))) return null;
  try {
    const out = execSync("git ls-files --cached --others --exclude-standard", {
      cwd: rootDir,
      timeout: GIT_TIMEOUT,
      encoding: "utf-8",
      stdio: ["pipe", "pipe", "pipe"]
    });
    return new Set(out.split("\n").map((l) => l.trim()).filter(Boolean));
  } catch {
    return null;
  }
}
function scanFiles(rootDir) {
  const allPaths = walkDir(rootDir, rootDir);
  const deployable = gitDeployableSet(rootDir);
  const results = [];
  for (const filePath of allPaths) {
    try {
      const relPath = path.relative(rootDir, filePath).replace(/\\/g, "/");
      if (deployable && !deployable.has(relPath)) continue;
      const stat = fs.statSync(filePath);
      if (stat.size > MAX_FILE_SIZE) continue;
      const content = fs.readFileSync(filePath, "utf-8");
      results.push({
        path: relPath,
        content
      });
    } catch {
    }
  }
  return results;
}

// src/framework.ts
import * as path2 from "path";
function detectFramework(files) {
  const fileNames = new Set(files.map((f) => path2.basename(f.path)));
  const find = (base) => files.find((f) => path2.basename(f.path) === base);
  if (files.some((f) => /^next\.config\.(js|mjs|ts)$/.test(path2.basename(f.path)))) return "next";
  const pkg = files.find((f) => f.path === "package.json");
  if (pkg && /"next"\s*:/.test(pkg.content)) return "next";
  const gradleOrPom = files.find(
    (f) => path2.basename(f.path) === "build.gradle" || path2.basename(f.path) === "build.gradle.kts" || path2.basename(f.path) === "pom.xml"
  );
  if (gradleOrPom && /spring-boot/i.test(gradleOrPom.content)) return "spring";
  if (fileNames.has("nest-cli.json")) return "nest";
  if (pkg && /@nestjs\//.test(pkg.content)) return "nest";
  if (files.some((f) => /^vite\.config\.(js|ts|mjs)$/.test(path2.basename(f.path)))) return "vite";
  if (pkg && /"vite"\s*:/.test(pkg.content)) return "vite";
  if (files.some((f) => f.path === ".streamlit/config.toml") || fileNames.has("streamlit_app.py")) {
    return "streamlit";
  }
  const reqTxt = find("requirements.txt");
  const pyProject = find("pyproject.toml");
  const pyText = `${reqTxt?.content ?? ""}
${pyProject?.content ?? ""}`;
  if (/streamlit/i.test(pyText)) return "streamlit";
  if (/fastapi/i.test(pyText)) return "fastapi";
  if (fileNames.has("manage.py") || /(^|\n)\s*django/i.test(pyText)) return "django";
  return "unknown";
}

// src/envvars.ts
import * as path3 from "path";
var BUILD_PREFIXES = ["NEXT_PUBLIC_", "VITE_", "REACT_APP_"];
var LOCKED_PATTERNS = [
  /SECRET/i,
  /PASSWORD/i,
  /PASSWD/i,
  /TOKEN/i,
  /_KEY$/i,
  /API_?KEY/i,
  /PRIVATE.*KEY/i,
  /^DATABASE_URL$/i,
  /^DB_URL$/i,
  /^REDIS_URL$/i
];
function classifyEnvVar(name) {
  if (BUILD_PREFIXES.some((p) => name.startsWith(p))) return "build";
  if (LOCKED_PATTERNS.some((p) => p.test(name))) return "locked";
  return "runtime";
}
function isEnvFile(p) {
  return /^\.env(\.|$)/.test(path3.basename(p));
}
function extractEnvVars(files) {
  const names = /* @__PURE__ */ new Set();
  for (const file of files) {
    if (isEnvFile(file.path)) {
      for (const line of file.content.split("\n")) {
        const trimmed = line.trim();
        if (!trimmed || trimmed.startsWith("#")) continue;
        const m = trimmed.match(/^([A-Z_][A-Z0-9_]*)\s*=/);
        if (m) names.add(m[1]);
      }
      continue;
    }
    if (/\.(ts|tsx|js|jsx|mjs|cjs|py)$/.test(file.path)) {
      for (const m of file.content.matchAll(/process\.env\.([A-Z_][A-Z0-9_]*)/g)) names.add(m[1]);
      for (const m of file.content.matchAll(/import\.meta\.env\.([A-Z_][A-Z0-9_]*)/g)) names.add(m[1]);
      for (const m of file.content.matchAll(
        /os\.environ(?:\.get)?\s*\[?\s*['"]([A-Z_][A-Z0-9_]*)['"]/g
      )) {
        names.add(m[1]);
      }
    }
  }
  return [...names].sort().map((name) => ({ name, class: classifyEnvVar(name) }));
}

