];
function isFalsePositivePath(file) {
  return FP_PATH.some((p) => p.test(file));
}
var COMMENT_PREFIX = /(?:^|\s)(?:\/\/|#|\*|<!--|\/\*)/;
var PEM_FN = /(?:from|to|parse|load|read|is|match|test|replace|import|export)pem/i;
function isPemMarkerReference(line, marker) {
  const idx = line.indexOf(marker);
  if (idx < 0) return false;
  const before = line.slice(0, idx);
  if (COMMENT_PREFIX.test(before)) return true;
  if (PEM_FN.test(line.replace(/[^a-z]/gi, ""))) return true;
  return false;
}
function shannonEntropy(s) {
  if (s.length === 0) return 0;
  const counts = /* @__PURE__ */ new Map();
  for (const ch of s) counts.set(ch, (counts.get(ch) ?? 0) + 1);
  let entropy = 0;
  for (const c of counts.values()) {
    const p = c / s.length;
    entropy -= p * Math.log2(p);
  }
  return entropy;
}
var SEC15_MIN_LENGTH = 20;
var SEC15_MIN_ENTROPY = 4;
var SEC15_CHARSET = /^[A-Za-z0-9+/=_-]+$/;
function looksLikeHighEntropySecret(value) {
  if (value.length < SEC15_MIN_LENGTH) return false;
  if (!SEC15_CHARSET.test(value)) return false;
  if (!/[A-Za-z]/.test(value) || !/[0-9]/.test(value)) return false;
  if (shannonEntropy(value) < SEC15_MIN_ENTROPY) return false;
  return true;
}
var SEC16_NAME_PATTERNS = [
  /SECRET/i,
  /PASSWORD/i,
  /PASSWD/i,
  /TOKEN/i,
  /_KEY$/i,
  /API_?KEY/i,
  /PRIVATE.*KEY/i,
  /^DATABASE_URL$/i,
  /^DB_URL$/i,
  /^REDIS_URL$/i,
  // secret-rules-only boost (NOT in LOCKED_PATTERNS): catches ADMIN_PW, DB_PWD
  /(^|_)PW(D)?($|_)/i
];
function isSuspiciousVarName(name) {
  return SEC16_NAME_PATTERNS.some((p) => p.test(name));
}
var SEC16_MIN_LENGTH = 12;
function isLongOrHighEntropyValue(value) {
  if (value.length >= SEC16_MIN_LENGTH) return true;
  if (value.length >= 8 && shannonEntropy(value) >= SEC15_MIN_ENTROPY) return true;
  return false;
}
function isSecretEnvName(name) {
  return SEC16_NAME_PATTERNS.some((p) => p.test(name));
}
var JS_ENV_FALLBACK = /process\.env(?:\.([A-Za-z_$][A-Za-z0-9_$]*)|\[\s*['"]([A-Za-z_$][A-Za-z0-9_$]*)['"]\s*\])\s*(?:\|\||\?\?)\s*['"]([^'"\n]+)['"]/g;
var PY_ENV_FALLBACK = /(?:os\.environ\.get|os\.getenv|getenv)\s*\(\s*['"]([A-Za-z_][A-Za-z0-9_]*)['"]\s*,\s*['"]([^'"\n]+)['"]\s*\)/g;
function findSecretFallbacks(line) {
  const hits = [];
  JS_ENV_FALLBACK.lastIndex = 0;
  let m;
  while ((m = JS_ENV_FALLBACK.exec(line)) !== null) {
    const name = m[1] ?? m[2] ?? "";
    const fallback = m[3] ?? "";
    if (!isSecretEnvName(name)) continue;
    if (looksLikePlaceholder(fallback)) continue;
    hits.push({ name, fallback });
  }
  PY_ENV_FALLBACK.lastIndex = 0;
  while ((m = PY_ENV_FALLBACK.exec(line)) !== null) {
    const name = m[1] ?? "";
    const fallback = m[2] ?? "";
    if (!isSecretEnvName(name)) continue;
    if (looksLikePlaceholder(fallback)) continue;
    hits.push({ name, fallback });
  }
  return hits;
}
