var PLACEHOLDER = [
  /dummy/i,
  /fake/i,
  /test[_-]?key/i,
  /placeholder/i,
  /sample/i,
  /your[_-]?api[_-]?key/i,
  /xxx+/i,
  /changeme/i,
  /example/i
];
function looksLikePlaceholder(value) {
  return PLACEHOLDER.some((p) => p.test(value));
}
var FP_PATH = [
  /(^|\/)__tests__\//,
  /(^|\/)tests?\//,
  /\.test\./,
  /\.spec\./,
  /(^|\/)fixtures?\//,
  /(^|\/)mocks?\//,
  /\.example\./,
  /(^|\/)examples?\//,
  /(^|\/)docs?\//,
  /\.md$/,
  /\.mdx$/
];
function isFalsePositivePath(file) {
  return FP_PATH.some((p) => p.test(file));
}
function shannonEntropy(s) {
  if (s.length === 0) return 0;
  const counts = /* @__PURE__ */ new Map();
  for (const ch of s) counts.set(ch, (counts.get(ch) ?? 0) + 1);
  let entropy = 0;
  for (const c of counts.values()) {
    const p = c / s.length;
    entropy -= p * Math.log2(p);
  }
  return entropy;
}
var SEC15_MIN_LENGTH = 20;
var SEC15_MIN_ENTROPY = 4;
var SEC15_CHARSET = /^[A-Za-z0-9+/=_-]+$/;
function looksLikeHighEntropySecret(value) {
  if (value.length < SEC15_MIN_LENGTH) return false;
  if (!SEC15_CHARSET.test(value)) return false;
  if (!/[A-Za-z]/.test(value) || !/[0-9]/.test(value)) return false;
  if (shannonEntropy(value) < SEC15_MIN_ENTROPY) return false;
  return true;
}
var SEC16_NAME_PATTERNS = [
  /SECRET/i,
  /PASSWORD/i,
  /PASSWD/i,
  /TOKEN/i,
  /_KEY$/i,
  /API_?KEY/i,
  /PRIVATE.*KEY/i,
  /^DATABASE_URL$/i,
  /^DB_URL$/i,
  /^REDIS_URL$/i,
  // secret-rules-only boost (NOT in LOCKED_PATTERNS): catches ADMIN_PW, DB_PWD
  /(^|_)PW(D)?($|_)/i
];
function isSuspiciousVarName(name) {
  return SEC16_NAME_PATTERNS.some((p) => p.test(name));
}
var SEC16_MIN_LENGTH = 12;
function isLongOrHighEntropyValue(value) {
  if (value.length >= SEC16_MIN_LENGTH) return true;
  if (value.length >= 8 && shannonEntropy(value) >= SEC15_MIN_ENTROPY) return true;
  return false;
}

// src/ai-prompt.ts
function buildAiPrompt(f) {
  if (f.severity !== "critical" && f.severity !== "high") return null;
  const loc = f.file ? f.line != null ? `${f.file}:${f.line}` : f.file : "\uD574\uB2F9 \uD30C\uC77C";
  if (f.inGitHistory) {
    return `${loc}\uC5D0\uC11C \uBC1C\uACAC\uB41C "${f.rule}" \uC2DC\uD06C\uB9BF\uC744 \uC989\uC2DC \uD3D0\uAE30\xB7\uC7AC\uBC1C\uAE09\uD558\uACE0, \uCF54\uB4DC\uC5D0\uC11C \uC81C\uAC70\uD55C \uB4A4 \uD658\uACBD\uBCC0\uC218\uB85C \uC62E\uAE30\uACE0 git \uC774\uB825\uC5D0\uC11C\uB3C4 \uC644\uC804\uD788 \uC81C\uAC70\uD574\uC918 (git filter-repo \uB4F1).`;
  }
  return `${loc}\uC758 \uD558\uB4DC\uCF54\uB529\uB41C "${f.rule}"\uC744(\uB97C) \uD658\uACBD\uBCC0\uC218\uB85C \uC62E\uAE30\uACE0, \uCF54\uB4DC\uC5D0\uC11C \uC81C\uAC70\uD55C \uB4A4 .gitignore\uC640 \uBC30\uD3EC \uD658\uACBD\uBCC0\uC218 \uC124\uC815\uC744 \uC810\uAC80\uD574\uC918.`;
}

// src/secret-scan.ts
var QUOTED_LITERAL = /'([^'\n]*)'|"([^"\n]*)"|`([^`\n]*)`/g;
var VAR_ASSIGNMENT = /([A-Za-z_$][A-Za-z0-9_$]*)\s*[:=]\s*['"`]([^'"`\n]*)['"`]/g;
function pushFinding(findings, partial) {
  findings.push({ ...partial, aiPrompt: buildAiPrompt(partial) });
}
function scanSecrets(files) {
  const findings = [];
  const compiled = SECRET_RULES.map((rule) => {
    try {
      return { rule, regex: new RegExp(rule.pattern, "i") };
    } catch {
      return null;
    }
  }).filter((x) => x !== null);
  for (const file of files) {
    if (isFalsePositivePath(file.path)) continue;
    const lines = file.content.split("\n");
    for (let i = 0; i < lines.length; i++) {
      const line = lines[i];
      const lineNo = i + 1;
      let explicitHitOnLine = false;
      for (const { rule, regex } of compiled) {
        const match = regex.exec(line);
        if (!match) continue;
        const value = match[1] || match[0];
        if (looksLikePlaceholder(value)) continue;
        explicitHitOnLine = true;
        pushFinding(findings, {
          severity: rule.severity,
          rule: rule.name,
          file: file.path,
          line: lineNo,
          message: rule.message,
          inGitHistory: false
        });
      }
      if (explicitHitOnLine) continue;
      const reportedValues = /* @__PURE__ */ new Set();
      VAR_ASSIGNMENT.lastIndex = 0;
      let am;
      while ((am = VAR_ASSIGNMENT.exec(line)) !== null) {
        const name = am[1];
        const value = am[2];
        if (looksLikePlaceholder(value)) continue;
        if (!isSuspiciousVarName(name)) continue;
        if (!isLongOrHighEntropyValue(value)) continue;
        reportedValues.add(value);
        pushFinding(findings, {
          severity: "high",
          rule: "Suspicious Var Name + Long Literal",
          file: file.path,
          line: lineNo,
          message: "\uBE44\uBC00\uB85C \uBCF4\uC774\uB294 \uBCC0\uC218\uC5D0 \uC2E4\uC81C \uAC12\uC774 \uCF54\uB4DC\uC5D0 \uC9C1\uC811 \uC801\uD600 \uC788\uC5B4\uC694. \uD658\uACBD\uBCC0\uC218\uB85C \uBD84\uB9AC\uD574 \uC8FC\uC138\uC694.",
          inGitHistory: false
        });
      }
      QUOTED_LITERAL.lastIndex = 0;
      let qm;
      while ((qm = QUOTED_LITERAL.exec(line)) !== null) {
        const value = qm[1] ?? qm[2] ?? qm[3] ?? "";
        if (reportedValues.has(value)) continue;
        if (looksLikePlaceholder(value)) continue;
        if (!looksLikeHighEntropySecret(value)) continue;
        reportedValues.add(value);
        pushFinding(findings, {
          severity: "high",
          rule: "High-Entropy String",
          file: file.path,
          line: lineNo,
          message: "\uC554\uD638\uCC98\uB7FC \uBCF4\uC774\uB294 \uBB34\uC791\uC704 \uBB38\uC790\uC5F4\uC774 \uCF54\uB4DC\uC5D0 \uC9C1\uC811 \uB4E4\uC5B4 \uC788\uC5B4\uC694. \uC2E4\uC81C \uBE44\uBC00\uBC88\uD638\xB7\uD0A4\uB77C\uBA74 \uD658\uACBD\uBCC0\uC218\uB85C \uC62E\uACA8 \uC8FC\uC138\uC694.",
          inGitHistory: false
        });
      }
    }
  }
  return findings;
}

// src/git-history.ts
import { execSync as execSync2 } from "child_process";
import * as fs2 from "fs";
import * as path4 from "path";
var TIMEOUT = 3e4;
var ENV_TEMPLATE_RE = /^\.env\.(example|sample|template|dist|defaults)$/;
function runGit(args, cwd) {
  try {
    return execSync2(`git ${args.join(" ")}`, {
      cwd,
      timeout: TIMEOUT,
      encoding: "utf-8",
      stdio: ["pipe", "pipe", "pipe"]
    }).trim();
  } catch {
    return null;
  }
}
function isGitRepo(cwd) {
  return fs2.existsSync(path4.join(cwd, ".git"));
}
function getOriginUrl(cwd) {
  return runGit(["remote", "get-url", "origin"], cwd);
}
function checkGitHistory(cwd) {
  if (!isGitRepo(cwd)) return [];
  const findings = [];
  const sensitiveFiles = runGit(
    [
      "log",
      "--all",
      "--full-history",
      "--diff-filter=A",
      "--name-only",
      "--pretty=format:",
      "--",
      ".env",
      '".env.*"',
      '"*.pem"',
      '"*.key"',
      '"*.jks"'
    ],
    cwd
  );
  if (sensitiveFiles) {
    const files = [...new Set(sensitiveFiles.split("\n").filter(Boolean))].filter((file) => !ENV_TEMPLATE_RE.test(path4.basename(file)));
    for (const file of files) {
      const base = {
        severity: "critical",
        rule: "Sensitive File in Git History",
        file,
        line: null,
        message: "Git \uC774\uB825\uC5D0 \uBBFC\uAC10 \uD30C\uC77C \uCEE4\uBC0B \uC774\uB825 \uC874\uC7AC \u2014 \uC2DC\uD06C\uB9BF \uC7AC\uBC1C\uAE09 + \uC774\uB825 \uC815\uB9AC \uD544\uC694",
        inGitHistory: true
      };
      findings.push({ ...base, aiPrompt: buildAiPrompt(base) });
    }
  }
  const stringScans = [
    {
      needle: "AKIA",
      rule: "AWS Key in Git History",
      message: "Git \uC774\uB825\uC5D0\uC11C AWS Access Key \uD328\uD134 \uBC1C\uACAC \u2014 \uD0A4 \uB85C\uD14C\uC774\uC158 + \uC774\uB825 \uC815\uB9AC \uD544\uC218"
    },
    {
      needle: "BEGIN PRIVATE KEY",
      rule: "Private Key in Git History",
      message: "Git \uC774\uB825\uC5D0\uC11C Private Key \uD328\uD134 \uBC1C\uACAC \u2014 \uD0A4 \uD3D0\uAE30 + \uC774\uB825 \uC815\uB9AC \uD544\uC218"
    },
    {
      needle: "sk-ant-api03-",
      rule: "Anthropic Key in Git History",
      message: "Git \uC774\uB825\uC5D0\uC11C Anthropic API Key \uD328\uD134 \uBC1C\uACAC \u2014 \uD0A4 \uC7AC\uBC1C\uAE09 + \uC774\uB825 \uC815\uB9AC \uD544\uC218"
    }
  ];
  for (const scan2 of stringScans) {
    const hits = runGit(["log", "--all", "-S", `"${scan2.needle}"`, "--oneline"], cwd);
    if (hits && hits.length > 0) {
      const count = hits.split("\n").filter(Boolean).length;
      const base = {
        severity: "critical",
        rule: scan2.rule,
        file: null,
        line: null,
        message: `${scan2.message} (${count}\uAC1C \uCEE4\uBC0B)`,
        inGitHistory: true
      };
      findings.push({ ...base, aiPrompt: buildAiPrompt(base) });
    }
  }
  return findings;
}

// src/index.ts
var SEVERITY_ORDER = { critical: 0, high: 1, medium: 2, low: 3 };
function determineVerdict(findings) {
  const hasCritical = findings.some((f) => f.severity === "critical");
  const inHistory = findings.some((f) => f.inGitHistory);
  if (hasCritical || inHistory) return "blocked";
  if (findings.some((f) => f.severity === "high")) return "caution";
  return "pass";
}
function verdictToExitCode(verdict) {
  if (verdict === "blocked") return 2;
  if (verdict === "caution") return 1;
  return 0;
}
function scan(args) {
  const rootDir = path5.resolve(args.path);
  const files = scanFiles(rootDir);
  const framework = detectFramework(files);
  const envVars = extractEnvVars(files);
  const findings = [...scanSecrets(files), ...checkGitHistory(rootDir)];
  findings.sort((a, b) => SEVERITY_ORDER[a.severity] - SEVERITY_ORDER[b.severity]);
  const summary = { critical: 0, high: 0, medium: 0, low: 0 };
  for (const f of findings) summary[f.severity]++;
  let repo = args.repo ?? null;
  if (repo == null && args.noPrompt && isGitRepo(rootDir)) {
    repo = getOriginUrl(rootDir);
  }
  return {
    schemaVersion: 1,
    target: {
      path: rootDir,
      repo,
      framework
    },
    verdict: determineVerdict(findings),
    summary,
    findings,
    envVars
  };
}

// src/cli.ts
function parseArgs(argv) {
  let path6 = "";
  let json = false;
  let noPrompt = false;
  for (const arg of argv) {
    if (arg === "--json") json = true;
    else if (arg === "--no-prompt") noPrompt = true;
    else if (arg.startsWith("--")) {
      process.stderr.write(`\uC54C \uC218 \uC5C6\uB294 \uC635\uC158: ${arg}
`);
    } else if (!path6) {
      path6 = arg;
    }
  }
  return { path: path6 || ".", json: json || true, noPrompt };
}
async function promptRepoUrl(cwd) {
  const origin = isGitRepo(cwd) ? getOriginUrl(cwd) : null;
  const rl = readline.createInterface({ input: process.stdin, output: process.stderr });
  const question = origin ? `? Git \uC800\uC7A5\uC18C URL [${origin}]: ` : "? Git \uC800\uC7A5\uC18C URL (\uC5C6\uC73C\uBA74 Enter): ";
  return new Promise((resolve2) => {
    rl.question(question, (answer) => {
      rl.close();
      const trimmed = answer.trim();
      resolve2(trimmed || origin || null);
    });
  });
}
async function main() {
  const args = parseArgs(process.argv.slice(2));
  let repo = null;
  if (args.noPrompt) {
    repo = isGitRepo(args.path) ? getOriginUrl(args.path) : null;
  } else if (process.stdin.isTTY) {
    repo = await promptRepoUrl(args.path);
  } else {
    repo = isGitRepo(args.path) ? getOriginUrl(args.path) : null;
  }
  process.stderr.write(`[engine] scanning ${args.path} ...
`);
  const verdict = scan({ path: args.path, noPrompt: args.noPrompt, repo });
  process.stderr.write(
    `[engine] verdict=${verdict.verdict} critical=${verdict.summary.critical} high=${verdict.summary.high} medium=${verdict.summary.medium} low=${verdict.summary.low}
`
  );
  process.stdout.write(JSON.stringify(verdict, null, 2) + "\n");
  process.exit(verdictToExitCode(verdict.verdict));
}
main().catch((err) => {
  process.stderr.write(`[engine] error: ${err?.message ?? err}
`);
  process.exit(2);
});
