  /^USER(_?NAME|_?ID)?$/i,
  /^(DEFAULT|ADMIN|DB|APP|LOGIN|SVC|SERVICE)_?USER(NAME)?$/i,
  /^ACCOUNT(_?NAME|_?ID)?$/i,
  /^LOGIN(_?ID|_?NAME)?$/i
];
function isAccountVarName(name) {
  return ACCOUNT_NAME_PATTERNS.some((p) => p.test(name));
}
