// src/ai-prompt.ts
function buildAiPrompt(f) {
  if (f.severity !== "critical" && f.severity !== "high") return null;
  const loc = f.file ? f.line != null ? `${f.file}:${f.line}` : f.file : "\uD574\uB2F9 \uD30C\uC77C";
  if (f.inGitHistory) {
    return `${loc}\uC5D0\uC11C \uBC1C\uACAC\uB41C "${f.rule}" \uC2DC\uD06C\uB9BF\uC744 \uC989\uC2DC \uD3D0\uAE30\xB7\uC7AC\uBC1C\uAE09\uD558\uACE0, \uCF54\uB4DC\uC5D0\uC11C \uC81C\uAC70\uD55C \uB4A4 \uD658\uACBD\uBCC0\uC218\uB85C \uC62E\uAE30\uACE0 git \uC774\uB825\uC5D0\uC11C\uB3C4 \uC644\uC804\uD788 \uC81C\uAC70\uD574\uC918 (git filter-repo \uB4F1).`;
  }
  if (isConnString(f.rule)) {
    return `${loc}\uC758 \uD3C9\uBB38 \uBE44\uBC00\uBC88\uD638\uAC00 \uB4E0 \uC5F0\uACB0 \uBB38\uC790\uC5F4\uC744 \uD658\uACBD\uBCC0\uC218\uB85C \uC62E\uACA8\uC918. \u26A0\uFE0F \uBE44\uBC00\uBC88\uD638 \uC77C\uBD80\uB9CC \uBC14\uAFB8\uC9C0 \uB9D0\uACE0, \uADF8 \uBCC0\uC218\uC758 \uAC12 \uC804\uCCB4(\`KEY=scheme://user:pass@host:port/db\` \uC804\uCCB4)\uB97C \uD1B5\uC9F8\uB85C \`KEY=\${KEY}\` \uAC19\uC740 \uD658\uACBD\uBCC0\uC218 \uCC38\uC870 \uD55C \uAC1C\uB85C \uAD50\uCCB4\uD574(\uBE44\uBC88\uC774 \uC911\uAC04\uC5D0\uC11C \uC798\uB824 \uD3C9\uBB38 \uC870\uAC01\uC774 \uB0A8\uC9C0 \uC54A\uAC8C). \uC2E4\uC81C \uAC12\uC740 gitignore \uB41C .env \uB85C \uC62E\uAE30\uACE0 .env.example \uC5D0 \uBE48 \uD0A4\uB9CC \uB0A8\uACA8\uC918. \uB9CC\uC57D \uC774 \uD30C\uC77C\uC774 docker-compose \uCC98\uB7FC \uBC30\uD3EC(Dockerfile \uB2E8\uB3C5)\uC5D0\uB294 \uC4F0\uC774\uC9C0 \uC54A\uB294 \uD30C\uC77C\uC774\uBA74, \uCE58\uD658\uD558\uC9C0 \uB9D0\uACE0 .dockerignore\xB7.gitignore \uB85C \uBE4C\uB4DC \uCEE8\uD14D\uC2A4\uD2B8\xB7git \uC804\uC1A1\uC5D0\uC11C \uC81C\uC678\uD558\uAC70\uB098(\uB610\uB294 \uBBF8\uC0AC\uC6A9\uC774 \uD655\uC2E4\uD558\uBA74 \uC0AD\uC81C) \uD3C9\uBB38\uC774 \uC0C8\uC9C0 \uC54A\uAC8C \uD574\uC918.`;
  }
  return `${loc}\uC758 \uD558\uB4DC\uCF54\uB529\uB41C "${f.rule}"\uC744(\uB97C) \uD658\uACBD\uBCC0\uC218\uB85C \uC62E\uAE30\uACE0, \uCF54\uB4DC\uC5D0\uC11C \uC81C\uAC70\uD55C \uB4A4 .gitignore\uC640 \uBC30\uD3EC \uD658\uACBD\uBCC0\uC218 \uC124\uC815\uC744 \uC810\uAC80\uD574\uC918.`;
}
function isConnString(rule) {
  return /connection string|conn[ -]?string|database.?url|credential.?in.?url|연결 문자열/i.test(rule);
}

// src/framework.ts
function detectFramework(files) {
  const fileNames = new Set(files.map((f) => path2.basename(f.path)));
  const find = (base) => files.find((f) => path2.basename(f.path) === base);
  if (files.some((f) => /^next\.config\.(js|mjs|ts)$/.test(path2.basename(f.path)))) return "next";
  const pkg = files.find((f) => f.path === "package.json");
  if (pkg && /"next"\s*:/.test(pkg.content)) return "next";
  const gradleOrPom = files.find(
    (f) => path2.basename(f.path) === "build.gradle" || path2.basename(f.path) === "build.gradle.kts" || path2.basename(f.path) === "pom.xml"
  );
  if (gradleOrPom && /spring-boot/i.test(gradleOrPom.content)) return "spring";
  if (fileNames.has("nest-cli.json")) return "nest";
  if (pkg && /@nestjs\//.test(pkg.content)) return "nest";
  if (files.some((f) => /^vite\.config\.(js|ts|mjs)$/.test(path2.basename(f.path)))) return "vite";
  if (pkg && /"vite"\s*:/.test(pkg.content)) return "vite";
  if (files.some((f) => f.path === ".streamlit/config.toml") || fileNames.has("streamlit_app.py")) {
    return "streamlit";
  }
  const reqTxt = find("requirements.txt");
  const pyProject = find("pyproject.toml");
  const pyText = `${reqTxt?.content ?? ""}
${pyProject?.content ?? ""}`;
  if (/streamlit/i.test(pyText)) return "streamlit";
  if (/fastapi/i.test(pyText)) return "fastapi";
  if (fileNames.has("manage.py") || /(^|\n)\s*django/i.test(pyText)) return "django";
  return "unknown";
}
var TELEMETRY_OFF_TOML = /gatherUsageStats\s*=\s*false/i;
var TELEMETRY_OFF_ENV = /STREAMLIT_BROWSER_GATHER_USAGE_STATS\s*[:=]\s*["']?false/i;
function scanStreamlitTelemetry(files) {
  if (detectFramework(files) !== "streamlit") return [];
  const disabled = files.some(
    (f) => TELEMETRY_OFF_TOML.test(f.content) || TELEMETRY_OFF_ENV.test(f.content)
  );
  if (disabled) return [];
  const configFile = files.find((f) => f.path === ".streamlit/config.toml")?.path ?? ".streamlit/config.toml";
  const partial = {
    severity: "medium",
    rule: "Streamlit Telemetry Not Disabled",
    file: configFile,
    line: 1,
    message: "Streamlit \uC0AC\uC6A9 \uD1B5\uACC4 \uC804\uC1A1\uC774 \uAEBC\uC838 \uC788\uC9C0 \uC54A\uC544\uC694(\uC0AC\uB0B4 \uC815\uCC45). .streamlit/config.toml \uC758 [browser] \uC139\uC158\uC5D0 gatherUsageStats = false \uB97C \uCD94\uAC00\uD558\uAC70\uB098 \uD658\uACBD\uBCC0\uC218 STREAMLIT_BROWSER_GATHER_USAGE_STATS=false \uB97C \uC124\uC815\uD558\uC138\uC694.",
    inGitHistory: false
  };
  return [{ ...partial, aiPrompt: buildAiPrompt(partial) }];
}

