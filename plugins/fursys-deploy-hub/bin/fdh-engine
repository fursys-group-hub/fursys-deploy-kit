  "service",
  "app",
  "api",
  "default",
  "anonymous",
  "nobody",
  "www-data",
  "deploy"
]);
var EMAIL_RE = /^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$/;
var PERSON_NAME_RE = /^[A-Za-z]{2,}[._][A-Za-z]{2,}([._][A-Za-z]{2,})?$/;
function looksLikePersonalAccount(value) {
  const v = value.trim();
  if (looksLikePlaceholder(v)) return false;
  if (GENERIC_ACCOUNT.has(v.toLowerCase())) return false;
  if (EMAIL_RE.test(v)) return true;
  if (PERSON_NAME_RE.test(v)) return true;
  return false;
}

// src/envvars.ts
var BUILD_PREFIXES = ["NEXT_PUBLIC_", "VITE_", "REACT_APP_"];
var LOCKED_PATTERNS = [
  /SECRET/i,
  /PASSWORD/i,
  /PASSWD/i,
  /(^|_)PWD($|_)/i,
  // DB_PWD / MYSQL_PWD / MAIL_PWD 등 — PWD 약어형 비밀번호(item8)
  /TOKEN/i,
  /_KEY$/i,
  /API_?KEY/i,
  /PRIVATE.*KEY/i,
  /^DATABASE_URL$/i,
  /^DB_URL$/i,
  /^REDIS_URL$/i
];
function classifyEnvVar(name) {
  if (BUILD_PREFIXES.some((p) => name.startsWith(p))) return "build";
  if (LOCKED_PATTERNS.some((p) => p.test(name))) return "locked";
  return "runtime";
}
function isEnvFile(p) {
  return /^\.env(\.|$)/.test(path3.basename(p));
}
function extractEnvVars(files) {
  const names = /* @__PURE__ */ new Set();
  for (const file of files) {
    if (isEnvFile(file.path)) {
      for (const line of file.content.split("\n")) {
        const trimmed = line.trim();
        if (!trimmed || trimmed.startsWith("#")) continue;
        const m = trimmed.match(/^([A-Z_][A-Z0-9_]*)\s*=/);
        if (m) names.add(m[1]);
      }
      continue;
    }
    if (/\.(ts|tsx|js|jsx|mjs|cjs|py)$/.test(file.path)) {
      for (const m of file.content.matchAll(/process\.env\.([A-Z_][A-Z0-9_]*)/g)) names.add(m[1]);
      for (const m of file.content.matchAll(/import\.meta\.env\.([A-Z_][A-Z0-9_]*)/g)) names.add(m[1]);
      for (const m of file.content.matchAll(
        /os\.environ(?:\.get)?\s*\[?\s*['"]([A-Z_][A-Z0-9_]*)['"]/g
      )) {
        names.add(m[1]);
      }
    }
  }
  return [...names].sort().map((name) => ({ name, class: classifyEnvVar(name) }));
}
var BUILD_SECRET_NAME = [
  /SECRET/i,
  /PASSWORD/i,
  /PASSWD/i,
  /(^|_)API_?KEY($|_)/i,
  // API_KEY / APIKEY (not plain *_KEY which may be public id)
  /PRIVATE[_-]?KEY/i,
  /ACCESS[_-]?TOKEN/i,
  /(^|_)TOKEN$/i
  // ends with TOKEN (e.g. SLACK_TOKEN) — bare client token = leak
];
function buildPrefixOf(name) {
  return BUILD_PREFIXES.find((p) => name.startsWith(p)) ?? null;
}
function nameLooksSecret(name) {
  return BUILD_SECRET_NAME.some((p) => p.test(name));
}
var SECRET_VALUE_PATTERNS = [
  /AKIA[0-9A-Z]{16}/,
  // AWS key id
  /sk-(?:ant-api03-|proj-)?[A-Za-z0-9_-]{20,}/,
  // OpenAI / Anthropic
  /AIza[0-9A-Za-z\-_]{35}/,
  // Google API key
  /-----BEGIN (?:RSA |OPENSSH |EC )?PRIVATE KEY-----/,
  // PEM
  /xox[bpsoa]-[0-9]{10,}-/,
  // Slack
  /eyJ[A-Za-z0-9_-]+\.eyJ[A-Za-z0-9_-]+\./
  // JWT
];
function valueLooksSecret(value) {
  if (looksLikePlaceholder(value)) return false;
  return SECRET_VALUE_PATTERNS.some((p) => p.test(value));
}
function envFileAssignments(file) {
  const out = [];
  for (const line of file.content.split("\n")) {
    const trimmed = line.trim();
    if (!trimmed || trimmed.startsWith("#")) continue;
    const m = trimmed.match(/^([A-Z_][A-Z0-9_]*)\s*=\s*(.*)$/);
    if (!m) continue;
    let value = m[2].trim();
    value = value.replace(/^['"]|['"]$/g, "");
    out.push({ name: m[1], value });
  }
  return out;
}
function scanBuildSecrets(files) {
  const findings = [];
  const seen = /* @__PURE__ */ new Set();
  const push = (name, file, reason) => {
    if (seen.has(name)) return;
    seen.add(name);
    const base = {
      severity: "critical",
      rule: "Secret in Build-time Variable",
      file,
      line: null,
      message: `${reason} \u2014 ${name} \uAC12\uC740 \uBE4C\uB4DC \uC2DC \uBE0C\uB77C\uC6B0\uC800 \uCF54\uB4DC(\uBC88\uB4E4)\uC5D0 \uADF8\uB300\uB85C \uBC15\uD600 \uB204\uAD6C\uB098 \uBCFC \uC218 \uC788\uC5B4\uC694. \uACF5\uAC1C \uC811\uB450\uC0AC(NEXT_PUBLIC_/VITE_/REACT_APP_)\uB97C \uBE7C\uACE0 \uC11C\uBC84 \uC804\uC6A9 \uBE44\uBC00\uB85C \uBD84\uB9AC\uD558\uC138\uC694.`,
      inGitHistory: false
    };
    findings.push({ ...base, aiPrompt: buildAiPrompt(base) });
  };
  for (const file of files) {
    if (isFalsePositivePath(file.path)) continue;
    if (/^\.env(\.|$)/.test(path3.basename(file.path))) {
      for (const { name, value } of envFileAssignments(file)) {
        if (!buildPrefixOf(name)) continue;
        if (value === "" || looksLikePlaceholder(value)) continue;
        if (nameLooksSecret(name)) {
          push(name, file.path, "\uBE44\uBC00\uB85C \uBCF4\uC774\uB294 \uC774\uB984\uC758 \uACF5\uAC1C \uBCC0\uC218");
        } else if (valueLooksSecret(value)) {
          push(name, file.path, "\uACF5\uAC1C \uBCC0\uC218\uC5D0 \uC2E4\uC81C \uBE44\uBC00\uD0A4 \uD615\uD0DC\uC758 \uAC12");
        }
      }
      continue;
    }
    if (/\.(ts|tsx|js|jsx|mjs|cjs)$/.test(file.path)) {
      for (const m of file.content.matchAll(
        /(?:process\.env|import\.meta\.env)\.([A-Z_][A-Z0-9_]*)/g
      )) {
        const name = m[1];
        if (!buildPrefixOf(name)) continue;
        if (nameLooksSecret(name)) push(name, file.path, "\uBE44\uBC00\uB85C \uBCF4\uC774\uB294 \uC774\uB984\uC758 \uACF5\uAC1C \uBCC0\uC218");
      }
    }
  }
  return findings;
}

// src/secret-scan.ts
var QUOTED_LITERAL = /'([^'\n]*)'|"([^"\n]*)"|`([^`\n]*)`/g;
var VAR_ASSIGNMENT = /([A-Za-z_$][A-Za-z0-9_$]*)\s*[:=]\s*['"`]([^'"`\n]*)['"`]/g;
function pushFinding(findings, partial) {
  findings.push({ ...partial, aiPrompt: buildAiPrompt(partial) });
}
function scanSecrets(files) {
  const findings = [];
  const compiled = SECRET_RULES.map((rule) => {
    try {
      return { rule, regex: new RegExp(rule.pattern, "i") };
    } catch {
      return null;
    }
  }).filter((x) => x !== null);
  for (const file of files) {
    if (isFalsePositivePath(file.path)) continue;
    const lines = file.content.split("\n");
    for (let i = 0; i < lines.length; i++) {
      const line = lines[i];
      const lineNo = i + 1;
      let explicitHitOnLine = false;
      for (const { rule, regex } of compiled) {
        const match = regex.exec(line);
        if (!match) continue;
        const value = match[1] || match[0];
        if (looksLikePlaceholder(value)) continue;
        if (rule.id === "SEC-03" && isPemMarkerReference(line, value)) continue;
        explicitHitOnLine = true;
        pushFinding(findings, {
          severity: rule.severity,
          rule: rule.name,
          file: file.path,
          line: lineNo,
          message: rule.message,
          inGitHistory: false
        });
      }
      const fallbackValues = /* @__PURE__ */ new Set();
      for (const fb of findSecretFallbacks(line)) {
        fallbackValues.add(fb.fallback);
        pushFinding(findings, {
          severity: "high",
          rule: "Hardcoded Secret Fallback",
          file: file.path,
          line: lineNo,
          message: "\uD658\uACBD\uBCC0\uC218\uAC00 \uC5C6\uC744 \uB54C \uC4F0\uB294 \uBE44\uBC00\uAC12(\uD3F4\uBC31)\uC774 \uCF54\uB4DC\uC5D0 \uADF8\uB300\uB85C \uC801\uD600 \uC788\uC5B4\uC694. \uD3F4\uBC31\uAC12\uC744 \uC9C0\uC6B0\uACE0 \uBC30\uD3EC \uC124\uC815\uAC12\uC73C\uB85C\uB9CC \uC8FC\uC785\uD558\uC138\uC694.",
          inGitHistory: false
        });
      }
      if (explicitHitOnLine) continue;
      const reportedValues = new Set(fallbackValues);
      VAR_ASSIGNMENT.lastIndex = 0;
      let am;
      while ((am = VAR_ASSIGNMENT.exec(line)) !== null) {
        const name = am[1];
        const value = am[2];
        if (looksLikePlaceholder(value)) continue;
        if (looksLikePublicUrl(value)) continue;
        if (isAccountVarName(name) && looksLikePersonalAccount(value)) {
          reportedValues.add(value);
          pushFinding(findings, {
            severity: "high",
            rule: "Hardcoded Personal Account",
            file: file.path,
            line: lineNo,
            message: "\uAC1C\uC778 \uACC4\uC815\uC73C\uB85C \uBCF4\uC774\uB294 \uAC12\uC774 \uCF54\uB4DC\uC5D0 \uC9C1\uC811 \uC801\uD600 \uC788\uC5B4\uC694. \uACF5\uC6A9/\uC11C\uBE44\uC2A4 \uACC4\uC815\uC744 \uC4F0\uACE0 \uBC30\uD3EC \uC124\uC815\uAC12\uC73C\uB85C \uBD84\uB9AC\uD558\uC138\uC694.",
            inGitHistory: false
          });
          continue;
        }
        if (!isSuspiciousVarName(name)) continue;
        if (!isLongOrHighEntropyValue(value)) continue;
        reportedValues.add(value);
        pushFinding(findings, {
          severity: "high",
          rule: "Suspicious Var Name + Long Literal",
          file: file.path,
          line: lineNo,
          message: "\uBE44\uBC00\uB85C \uBCF4\uC774\uB294 \uBCC0\uC218\uC5D0 \uC2E4\uC81C \uAC12\uC774 \uCF54\uB4DC\uC5D0 \uC9C1\uC811 \uC801\uD600 \uC788\uC5B4\uC694. \uD658\uACBD\uBCC0\uC218\uB85C \uBD84\uB9AC\uD574 \uC8FC\uC138\uC694.",
          inGitHistory: false
        });
      }
      QUOTED_LITERAL.lastIndex = 0;
      let qm;
      while ((qm = QUOTED_LITERAL.exec(line)) !== null) {
        const value = qm[1] ?? qm[2] ?? qm[3] ?? "";
        if (reportedValues.has(value)) continue;
        if (looksLikePlaceholder(value)) continue;
        if (looksLikePublicUrl(value)) continue;
        if (!looksLikeHighEntropySecret(value)) continue;
        reportedValues.add(value);
        pushFinding(findings, {
          severity: "high",
          rule: "High-Entropy String",
          file: file.path,
          line: lineNo,
          message: "\uC554\uD638\uCC98\uB7FC \uBCF4\uC774\uB294 \uBB34\uC791\uC704 \uBB38\uC790\uC5F4\uC774 \uCF54\uB4DC\uC5D0 \uC9C1\uC811 \uB4E4\uC5B4 \uC788\uC5B4\uC694. \uC2E4\uC81C \uBE44\uBC00\uBC88\uD638\xB7\uD0A4\uB77C\uBA74 \uD658\uACBD\uBCC0\uC218\uB85C \uC62E\uACA8 \uC8FC\uC138\uC694.",
          inGitHistory: false
        });
      }
    }
  }
  return findings;
}

// src/git-history.ts
import { execSync as execSync2 } from "child_process";
import * as fs2 from "fs";
import * as path4 from "path";
var TIMEOUT = 3e4;
var ENV_TEMPLATE_RE = /^\.env\.(example|sample|template|dist|defaults)$/;
function runGit(args, cwd) {
  try {
    return execSync2(`git ${args.join(" ")}`, {
      cwd,
      timeout: TIMEOUT,
      encoding: "utf-8",
      stdio: ["pipe", "pipe", "pipe"]
    }).trim();
  } catch {
    return null;
  }
}
function isGitRepo(cwd) {
  return fs2.existsSync(path4.join(cwd, ".git"));
}
function getOriginUrl(cwd) {
  return runGit(["remote", "get-url", "origin"], cwd);
}
function checkGitHistory(cwd) {
  if (!isGitRepo(cwd)) return [];
  const findings = [];
  const sensitiveFiles = runGit(
    [
      "log",
      "--all",
      "--full-history",
      "--diff-filter=A",
      "--name-only",
      "--pretty=format:",
      "--",
      ".env",
      '".env.*"',
      '"*.pem"',
      '"*.key"',
      '"*.jks"'
    ],
    cwd
  );
  if (sensitiveFiles) {
    const files = [...new Set(sensitiveFiles.split("\n").filter(Boolean))].filter((file) => !ENV_TEMPLATE_RE.test(path4.basename(file)));
    for (const file of files) {
      const base = {
        severity: "critical",
        rule: "Sensitive File in Git History",
        file,
        line: null,
        message: "Git \uC774\uB825\uC5D0 \uBBFC\uAC10 \uD30C\uC77C \uCEE4\uBC0B \uC774\uB825 \uC874\uC7AC \u2014 \uC2DC\uD06C\uB9BF \uC7AC\uBC1C\uAE09 + \uC774\uB825 \uC815\uB9AC \uD544\uC694",
        inGitHistory: true
      };
      findings.push({ ...base, aiPrompt: buildAiPrompt(base) });
    }
  }
  const stringScans = [
    {
      needle: "AKIA",
      rule: "AWS Key in Git History",
      message: "Git \uC774\uB825\uC5D0\uC11C AWS Access Key \uD328\uD134 \uBC1C\uACAC \u2014 \uD0A4 \uB85C\uD14C\uC774\uC158 + \uC774\uB825 \uC815\uB9AC \uD544\uC218"
    },
    {
      needle: "BEGIN PRIVATE KEY",
      rule: "Private Key in Git History",
      message: "Git \uC774\uB825\uC5D0\uC11C Private Key \uD328\uD134 \uBC1C\uACAC \u2014 \uD0A4 \uD3D0\uAE30 + \uC774\uB825 \uC815\uB9AC \uD544\uC218"
    },
    {
      needle: "sk-ant-api03-",
      rule: "Anthropic Key in Git History",
      message: "Git \uC774\uB825\uC5D0\uC11C Anthropic API Key \uD328\uD134 \uBC1C\uACAC \u2014 \uD0A4 \uC7AC\uBC1C\uAE09 + \uC774\uB825 \uC815\uB9AC \uD544\uC218"
    }
  ];
  for (const scan2 of stringScans) {
    const hits = runGit(["log", "--all", "-S", `"${scan2.needle}"`, "--oneline"], cwd);
    if (hits && hits.length > 0) {
      const count = hits.split("\n").filter(Boolean).length;
      const base = {
        severity: "critical",
        rule: scan2.rule,
        file: null,
        line: null,
        message: `${scan2.message} (${count}\uAC1C \uCEE4\uBC0B)`,
        inGitHistory: true
      };
      findings.push({ ...base, aiPrompt: buildAiPrompt(base) });
    }
  }
  return findings;
}

// src/datafiles.ts
import { execSync as execSync3 } from "child_process";
import * as fs3 from "fs";
import * as path5 from "path";
var TIMEOUT2 = 3e4;
function isGitRepo2(cwd) {
  return fs3.existsSync(path5.join(cwd, ".git"));
}
function gitTrackedFiles(cwd) {
  if (!isGitRepo2(cwd)) return null;
  try {
    const out = execSync3("git ls-files", {
      cwd,
      timeout: TIMEOUT2,
      encoding: "utf-8",
      stdio: ["pipe", "pipe", "pipe"]
    });
    return out.split("\n").map((l) => l.trim()).filter(Boolean);
  } catch {
    return null;
  }
}
var SKIP_PATH = [
  /(^|\/)__tests__\//,
  /(^|\/)tests?\//,
  /(^|\/)fixtures?\//,
  /(^|\/)mocks?\//,
  /(^|\/)examples?\//,
  /(^|\/)samples?\//,
  /(^|\/)docs?\//,
  /(^|\/)node_modules\//,
  /(^|\/)\.venv\//
];
function isSkippedPath(rel) {
  return SKIP_PATH.some((p) => p.test(rel));
}
var SAMPLE_BASENAME = /(^|[._-])(sample|example|template|dummy|test|fixture|seed|schema)([._-]|$)/i;
var DATA_EXTENSIONS = /* @__PURE__ */ new Set([
  ".xlsx",
  ".xls",
  ".xlsm",
  ".db",
  ".sqlite",
  ".sqlite3",
  ".csv",
  ".tsv",
  ".mdb",
  ".accdb",
  ".parquet"
]);
var MIN_TEXT_DATA_BYTES = 64;
function scanDataFiles(cwd) {
  const tracked = gitTrackedFiles(cwd);
  if (!tracked) return [];
  const findings = [];
  for (const rel of tracked) {
    if (isSkippedPath(rel)) continue;
    const ext = path5.extname(rel).toLowerCase();
    if (!DATA_EXTENSIONS.has(ext)) continue;
    const base = path5.basename(rel);
    if (SAMPLE_BASENAME.test(base)) continue;
    const full = path5.join(cwd, rel);
    let size = 0;
    try {
      size = fs3.statSync(full).size;
    } catch {
      continue;
    }
    if (size === 0) continue;
    const isText = ext === ".csv" || ext === ".tsv";
    if (isText && size < MIN_TEXT_DATA_BYTES) continue;
    const finding = {
      severity: "high",
      rule: "Data File in Git",
      file: rel,
      line: null,
      message: "\uC5C5\uBB34/\uAE30\uBC00 \uB370\uC774\uD130\uB85C \uBCF4\uC774\uB294 \uD30C\uC77C\uC774 \uCF54\uB4DC \uC800\uC7A5\uC18C(git)\uC5D0 \uB4E4\uC5B4 \uC788\uC5B4\uC694. git \uC744 \uB370\uC774\uD130 \uC800\uC7A5\uC18C\uB85C \uC4F0\uC9C0 \uB9D0\uACE0 .gitignore \uC5D0 \uCD94\uAC00\uD55C \uB4A4 \uCD94\uC801\uC5D0\uC11C \uBE7C\uC138\uC694(\uBBFC\uAC10 \uB370\uC774\uD130\uBA74 IT\uBCF8\uBD80\uC5D0 \uC54C\uB9AC\uC138\uC694).",
      inGitHistory: false
    };
    findings.push({ ...finding, aiPrompt: buildAiPrompt(finding) });
  }
  return findings;
}
var JSON_MAX_BYTES = 64 * 1024;
function scanServiceAccountKeys(cwd) {
  const tracked = gitTrackedFiles(cwd);
  if (!tracked) return [];
  const findings = [];
  for (const rel of tracked) {
    if (isSkippedPath(rel)) continue;
    if (path5.extname(rel).toLowerCase() !== ".json") continue;
    const base = path5.basename(rel);
    if (SAMPLE_BASENAME.test(base)) continue;
    const full = path5.join(cwd, rel);
    let content;
    try {
      if (fs3.statSync(full).size > JSON_MAX_BYTES) continue;
      content = fs3.readFileSync(full, "utf-8");
    } catch {
      continue;
    }
    const isServiceAccount = /"type"\s*:\s*"service_account"/.test(content);
    const hasPrivateKey = /"private_key"\s*:\s*"-----BEGIN (?:RSA |EC )?PRIVATE KEY-----/.test(content);
    if (!isServiceAccount || !hasPrivateKey) continue;
    const finding = {
      severity: "critical",
      rule: "Service Account Key in Git",
      file: rel,
      line: null,
      message: "\uD074\uB77C\uC6B0\uB4DC \uC11C\uBE44\uC2A4 \uACC4\uC815 \uD0A4(\uAC1C\uC778\uD0A4 \uD3EC\uD568)\uAC00 \uCF54\uB4DC \uC800\uC7A5\uC18C(git)\uC5D0 \uB4E4\uC5B4 \uC788\uC5B4\uC694 \u2014 \uC989\uC2DC \uD0A4\uB97C \uD3D0\uAE30\xB7\uC7AC\uBC1C\uAE09\uD558\uACE0, \uD30C\uC77C\uC744 \uC0AD\uC81C\uD55C \uB4A4 .gitignore \uC5D0 \uCD94\uAC00\uD558\uACE0 IT\uBCF8\uBD80\uC5D0 \uC54C\uB9AC\uC138\uC694.",
      inGitHistory: false
    };
    findings.push({ ...finding, aiPrompt: buildAiPrompt(finding) });
  }
  return findings;
}

// src/index.ts
var SEVERITY_ORDER = { critical: 0, high: 1, medium: 2, low: 3 };
function determineVerdict(findings) {
  const hasCritical = findings.some((f) => f.severity === "critical");
  const inHistory = findings.some((f) => f.inGitHistory);
  if (hasCritical || inHistory) return "blocked";
  if (findings.some((f) => f.severity === "high")) return "caution";
  return "pass";
}
function verdictToExitCode(verdict) {
  if (verdict === "blocked") return 2;
  if (verdict === "caution") return 1;
  return 0;
}
function scan(args) {
  const rootDir = path6.resolve(args.path);
  const files = scanFiles(rootDir);
  const framework = detectFramework(files);
  const envVars = extractEnvVars(files);
  const findings = [
    ...scanSecrets(files),
    ...scanBuildSecrets(files),
    ...checkGitHistory(rootDir),
    ...scanDataFiles(rootDir),
    ...scanServiceAccountKeys(rootDir),
    ...scanStreamlitTelemetry(files)
  ];
  findings.sort((a, b) => SEVERITY_ORDER[a.severity] - SEVERITY_ORDER[b.severity]);
  const summary = { critical: 0, high: 0, medium: 0, low: 0 };
  for (const f of findings) summary[f.severity]++;
  let repo = args.repo ?? null;
  if (repo == null && args.noPrompt && isGitRepo(rootDir)) {
    repo = getOriginUrl(rootDir);
  }
  return {
    schemaVersion: 1,
    target: {
      path: rootDir,
      repo,
      framework
    },
    verdict: determineVerdict(findings),
    summary,
    findings,
    envVars
  };
}

// src/cli.ts
function parseArgs(argv) {
  let path7 = "";
  let json = false;
  let noPrompt = false;
  for (const arg of argv) {
    if (arg === "--json") json = true;
    else if (arg === "--no-prompt") noPrompt = true;
    else if (arg.startsWith("--")) {
      process.stderr.write(`\uC54C \uC218 \uC5C6\uB294 \uC635\uC158: ${arg}
`);
    } else if (!path7) {
      path7 = arg;
    }
  }
  return { path: path7 || ".", json: json || true, noPrompt };
}
async function promptRepoUrl(cwd) {
  const origin = isGitRepo(cwd) ? getOriginUrl(cwd) : null;
  const rl = readline.createInterface({ input: process.stdin, output: process.stderr });
  const question = origin ? `? Git \uC800\uC7A5\uC18C URL [${origin}]: ` : "? Git \uC800\uC7A5\uC18C URL (\uC5C6\uC73C\uBA74 Enter): ";
  return new Promise((resolve2) => {
    rl.question(question, (answer) => {
      rl.close();
      const trimmed = answer.trim();
      resolve2(trimmed || origin || null);
    });
  });
}
async function main() {
  const args = parseArgs(process.argv.slice(2));
  let repo = null;
  if (args.noPrompt) {
    repo = isGitRepo(args.path) ? getOriginUrl(args.path) : null;
  } else if (process.stdin.isTTY) {
    repo = await promptRepoUrl(args.path);
  } else {
    repo = isGitRepo(args.path) ? getOriginUrl(args.path) : null;
  }
  process.stderr.write(`[engine] scanning ${args.path} ...
`);
  const verdict = scan({ path: args.path, noPrompt: args.noPrompt, repo });
  process.stderr.write(
    `[engine] verdict=${verdict.verdict} critical=${verdict.summary.critical} high=${verdict.summary.high} medium=${verdict.summary.medium} low=${verdict.summary.low}
`
  );
  process.stdout.write(JSON.stringify(verdict, null, 2) + "\n");
  process.exit(verdictToExitCode(verdict.verdict));
}
main().catch((err) => {
  process.stderr.write(`[engine] error: ${err?.message ?? err}
`);
  process.exit(2);
});
